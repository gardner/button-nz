# Secrets — never commit real keys (this repo is public)
.env
.env.*
!.env.example

# Python (uv)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Node (pnpm)
node_modules/
.next/
dist/

# Blender backups
*.blend1

# Root-level markdown stays local and ephemeral (docs/ is unaffected)
# Keep only the two root files every clone needs.
/*.md
!/README.md
!/AGENTS.md
