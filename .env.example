# Copy to .env and fill in secrets. Never commit .env (this repo is public).
LINZ_BASEMAP_API_KEY=

# Public service endpoints (no secrets — safe to commit)
BULLER_PROPERTY_FEATURESERVER_URL=https://services6.arcgis.com/Whb8vGWSmNkavSpL/arcgis/rest/services/BDC_Property_Master_Public_View/FeatureServer
NELSON_PROPERTY_MAPSERVER_URL=https://www.topofthesouthmaps.co.nz/arcgis/rest/services/ArcGISOnline_NCC/PropertyBoundariesWithAssess/MapServer
LINZ_ADDRESSES_FEATURESERVER_URL=https://services.arcgis.com/xdsHIIxuCWByZiCB/arcgis/rest/services/LINZ_NZ_Addresses/FeatureServer
LINZ_BUILDING_OUTLINES_FEATURESERVER_URL=https://services.arcgis.com/xdsHIIxuCWByZiCB/arcgis/rest/services/LINZ_NZ_Building_Outlines/FeatureServer

# LINZ Basemaps aerial tiles. Append ?api=$LINZ_BASEMAP_API_KEY at request
# time. Never paste the key into a committed URL.
LINZ_BASEMAP_AERIAL_NZTM_WMTS_URL=https://basemaps.linz.govt.nz/v1/tiles/aerial/NZTM2000Quad/WMTSCapabilities.xml
LINZ_BASEMAP_AERIAL_WEBMERCATOR_WMTS_URL=https://basemaps.linz.govt.nz/v1/tiles/aerial/WebMercatorQuad/WMTSCapabilities.xml
LINZ_BASEMAP_AERIAL_XYZ_TEMPLATE=https://basemaps.linz.govt.nz/v1/tiles/aerial/WebMercatorQuad/{z}/{x}/{y}.webp
